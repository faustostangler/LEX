# LEX Centralized Environment Configuration
# Adheres to fail-fast 12-Factor App principles

# PostgreSQL Connection DSN
LEX_DATABASE_URL=postgresql://lex:lex@localhost:5432/lex

# Crawler Concurrency & Network Limits
LEX_MAX_CONCURRENT_REQUESTS=16
LEX_CONCURRENT_REQUESTS_PER_DOMAIN=4
LEX_DOWNLOAD_DELAY=0.5

# AutoThrottle Dynamic Controls
LEX_AUTOTHROTTLE_ENABLED=true
LEX_AUTOTHROTTLE_START_DELAY=1.0
LEX_AUTOTHROTTLE_MAX_DELAY=30.0
LEX_AUTOTHROTTLE_TARGET_CONCURRENCY=2.0

# Memory Threshold for Binary Stream Spooling (MB)
LEX_MAX_SPOOL_MEMORY_MB=10

# Logging & Environment
LEX_ENVIRONMENT=development
LEX_LOG_LEVEL=INFO
LEX_LOG_FILE=logs/crawler.log
